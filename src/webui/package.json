{
  "name": "ai-driven-event-discovery_webui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fix": "ts-jest config:migrate jest.config.js",
    "start:nobuild": "tsx webserver/dist/server.js",
    "start": "npm run build && tsx webserver/dist/server.js",
    "build": "npm run build:server && npm run build:client",
    "build:ps": "(npm run build:server:ps) && (npm run build:client:ps)",
    "build:server": "cd webserver/ && npm install --force && tsc  --build --clean && tsc -p .",
    "build:server:ps": "(cd webserver/) -and (npm install --force) -and (tsc --build) -and (tsc -p .)",
    "build:client": "cd client/ && npm install --force && npm run build",
    "build:client:ps": "(cd client/) -and n(pm install --force) -and (npm run build)"
  },
  "dependencies": {
    "@apollo/server": "^4.3.3",
    "@as-integrations/express5": "^1.0.0",
    "@aws-sdk/client-sns": "^3.839.0",
    "@aws-sdk/client-sqs": "^3.840.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.2.0",
    "@mui/x-data-grid": "^8.9.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/node": "^22.15.17",
    "ai-driven-event-discovery": "file:",
    "axios": "^1.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "fs": "^0.0.1-security",
    "graphql-scalars": "^1.24.2",
    "graphql-tag": "^2.12.6",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "oidc-client-ts": "^3.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.10",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38"
  }
}
